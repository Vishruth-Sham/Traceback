# Copy to .env.local. Never commit real values.
TRACEBACK_API_BASE_URL=http://127.0.0.1:8000
TRACEBACK_API_TOKEN=REPLACE_WITH_THE_SAME_TOKEN_FROM_THE_REPO_ROOT_.env
# Optional: server-side cap (bytes) for POST /api/v1/voice-captures. Must be >= the backend's
# TRACEBACK_VOICE_MAX_UPLOAD_BYTES (default 10485760). Not a NEXT_PUBLIC value; never exposed to the browser.
# TRACEBACK_VOICE_MAX_UPLOAD_BYTES=10485760
