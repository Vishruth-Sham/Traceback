# local_db.py init generates a real private .env automatically if absent.
TRACEBACK_DATABASE_URL=postgresql+psycopg://traceback:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/traceback
TRACEBACK_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
TRACEBACK_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRACEBACK_USER_TIMEZONE=Asia/Kolkata
TRACEBACK_ASSET_DIR=.local/traceback/assets
TRACEBACK_MAX_UPLOAD_BYTES=104857600

# Local capture processor. The runner also accepts TRACEBACK_API_TOKEN above.
TRACEBACK_PROCESSOR_API_BASE_URL=http://127.0.0.1:8000
TRACEBACK_PROCESSOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
TRACEBACK_PROCESSOR_OLLAMA_MODEL=qwen3.5:4b
TRACEBACK_PROCESSOR_WHISPER_MODEL_PATH=~/.cache/whisper-cpp/ggml-small.bin

# Local MCP stdio adapter (python -m traceback_mcp). Reuses TRACEBACK_API_TOKEN
# above; only override these if the REST API runs on a non-default loopback port.
TRACEBACK_MCP_API_BASE_URL=http://127.0.0.1:8000
TRACEBACK_MCP_CLIENT_LABEL=mcp
